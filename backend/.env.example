HTTP_PORT=8080
APP_DEBUG=false
CROND_DB_PATH=./data/crond.db
# 默认框架模板为磁盘文件；部署时需携带此目录
CROND_FRAMEWORK_DIR=./data/framework

# 框架文本文件：<根目录>/<用户ID>/files/，默认使用数据库同目录的 projects
# CROND_FILES_DIR=./data/projects
CROND_WORK_DIR=./data/workspaces
CROND_TEST_LOGIN=true
# FIREBASE_API_KEY=your-public-firebase-web-api-key

# QQ 互联网站应用；回调地址须与 QQ 平台配置一致
# QQ_APP_ID=your-qq-app-id
# QQ_APP_KEY=your-qq-app-key
# QQ_REDIRECT_URL=http://localhost:3000/api/auth/qq/callback

# Composer PHAR 由 Origami 执行，不依赖系统 PHP 或 Composer 可执行程序
CROND_COMPOSER_PHAR=./data/tools/composer.phar
